# Koha API Configuration
KOHA_BASE_URL=https://library.al-burhaan.org/api/v1
KOHA_USERNAME=your_koha_username
KOHA_PASSWORD=your_koha_password

# Guest Account (pre-created in Koha)
KOHA_GUEST_CARDNUMBER=guest_card_number
KOHA_GUEST_PASSWORD=guest_password

# PostgreSQL Database
DATABASE_URL=postgresql://user:password@localhost:5432/burhaan_library

# JWT Configuration
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=7d

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
