// Prisma Schema for Al-Burhaan Library App
// This schema handles app-specific data not stored in Koha

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Sessions (JWT management)
model Session {
  id        String   @id @default(uuid())
  patronId  Int      @map("patron_id")
  token     String   @unique
  kohaToken String?  @map("koha_token")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sessions")
}

// User Preferences (not stored in Koha)
model UserPreference {
  id                   String   @id @default(uuid())
  patronId             Int      @unique @map("patron_id")
  language             String   @default("en") // en, ar, ur
  theme                String   @default("light") // light, dark
  notificationsEnabled Boolean  @default(true) @map("notifications_enabled")
  homeLibraryId        String?  @map("home_library_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("user_preferences")
}

// Favorites (books saved by users)
model Favorite {
  id        String   @id @default(uuid())
  patronId  Int      @map("patron_id")
  biblioId  Int      @map("biblio_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([patronId, biblioId])
  @@index([patronId])
  @@map("favorites")
}

// Recently Viewed Books
model RecentlyViewed {
  id       String   @id @default(uuid())
  patronId Int      @map("patron_id")
  biblioId Int      @map("biblio_id")
  viewedAt DateTime @default(now()) @map("viewed_at")

  @@unique([patronId, biblioId])
  @@index([patronId])
  @@map("recently_viewed")
}

// Push Notification Tokens
model PushToken {
  id          String   @id @default(uuid())
  patronId    Int      @map("patron_id")
  deviceToken String   @map("device_token")
  platform    String?  // ios, android, web
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([patronId])
  @@map("push_tokens")
}

// Cached Filter Options (subjects, classifications, etc.)
model FilterCache {
  id         String   @id @default(uuid())
  filterType String   @map("filter_type") // subject, classification, language
  value      String
  valueAr    String?  @map("value_ar") // Arabic translation
  valueUr    String?  @map("value_ur") // Urdu translation
  bookCount  Int      @default(0) @map("book_count")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([filterType, value])
  @@index([filterType])
  @@map("filter_cache")
}
