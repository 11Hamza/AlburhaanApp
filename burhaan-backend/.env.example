# Al-Burhaan Library Backend - Environment Configuration
# Copy this file to .env.local and fill in your values

# ===========================================
# KOHA LIBRARY SYSTEM
# ===========================================

# Koha API Base URL (without trailing slash)
KOHA_BASE_URL=https://library.al-burhaan.org/api/v1

# Koha Admin Credentials (for system-level API access)
KOHA_USERNAME=api_user
KOHA_PASSWORD=your_secure_password

# Guest Account (for unauthenticated browsing)
KOHA_GUEST_CARDNUMBER=GUEST001
KOHA_GUEST_PASSWORD=guest_password

# ===========================================
# AUTHENTICATION
# ===========================================

# JWT Secret Key (use a strong random string)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters
JWT_EXPIRES_IN=7d

# ===========================================
# OAUTH - GOOGLE
# ===========================================

# Google OAuth2 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===========================================
# OAUTH - MICROSOFT
# ===========================================

# Microsoft Azure AD Credentials (from Azure Portal)
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# ===========================================
# OAUTH REDIRECT
# ===========================================

# Base URL for OAuth callbacks (your backend URL)
OAUTH_REDIRECT_URI=https://your-backend.com/api/auth/callback

# ===========================================
# PUSH NOTIFICATIONS (Firebase)
# ===========================================

# Firebase Cloud Messaging Server Key (from Firebase Console)
FCM_SERVER_KEY=your-fcm-server-key

# ===========================================
# DATABASE (Optional - uses in-memory by default)
# ===========================================

# PostgreSQL Connection String
# DATABASE_URL=postgresql://user:password@localhost:5432/alburhaan

# ===========================================
# APP SETTINGS
# ===========================================

# Next.js
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000

# ===========================================
# NOTES
# ===========================================

# 1. KOHA SETUP:
#    - Create an API user in Koha with appropriate permissions
#    - Create a GUEST patron with restricted category (no borrowing)
#    - Enable REST API in Koha system preferences

# 2. GOOGLE OAUTH SETUP:
#    - Go to Google Cloud Console > APIs & Services > Credentials
#    - Create OAuth 2.0 Client ID (Web application)
#    - Add authorized redirect URI: {OAUTH_REDIRECT_URI}/google

# 3. MICROSOFT OAUTH SETUP:
#    - Go to Azure Portal > Azure Active Directory > App registrations
#    - Create new registration
#    - Add redirect URI: {OAUTH_REDIRECT_URI}/microsoft
#    - Create client secret in Certificates & secrets

# 4. FIREBASE SETUP:
#    - Go to Firebase Console > Project Settings > Cloud Messaging
#    - Copy the Server Key (Legacy server key)
